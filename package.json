{
  "name": "food-map",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "DEV_ACCOUNT=dev DATA_DIR=./data node --watch src/server/index.ts",
    "build": "vite build",
    "start": "node src/server/index.ts",
    "check": "tsc && vitest run",
    "migrate-v1": "node scripts/migrate-v1.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "leaflet": "^1.9.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
