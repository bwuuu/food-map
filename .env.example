# Copy to .env (never committed). Neither value is a secret, but both are required.
# Zero Trust team domain, e.g. yourteam.cloudflareaccess.com (https:// is fine too)
ACCESS_TEAM_DOMAIN=
# Access → Applications → this app → Overview → Application Audience (AUD) Tag
ACCESS_AUD=

# Do NOT put ANTHROPIC_API_KEY or GOOGLE_PLACES_API_KEY here: they are credentials.
# Export them from Bitwarden in the shell that runs `docker compose up` (see README).
